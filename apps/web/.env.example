# ==============================================================================
# AgroIntegra Web (@agrointegra/web) — Exemplo de variáveis de ambiente
# ==============================================================================
# Copie este arquivo para apps/web/.env.local apenas em desenvolvimento local.
# NUNCA coloque credenciais reais, chaves secretas, tokens administrativos ou a
# SUPABASE_SERVICE_ROLE_KEY neste arquivo ou em variáveis NEXT_PUBLIC_*.
# Tudo com prefixo NEXT_PUBLIC_ é embutido no bundle JavaScript enviado ao navegador.
# ==============================================================================

# URL base da API NestJS (apps/api).
# Em desenvolvimento local: http://localhost:3001
# Em produção: obrigatório usar HTTPS (ex.: https://api.agrointegra.gov.br)
# Não inclua usuário/senha, query string ou fragmento (#).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Modo de autenticação do frontend:
# - "legacy" (único modo implementado atualmente: login via POST /auth/login da API NestJS)
# - "supabase" ainda NÃO está implementado no frontend e é rejeitado pela configuração.
NEXT_PUBLIC_AUTH_MODE=legacy

# ------------------------------------------------------------------------------
# Variáveis reservadas para uso futuro (opcionais; não necessárias hoje porque
# a arquitetura preserva a fronteira da API NestJS, sem SDK Supabase no browser).
# Nunca grave chaves reais neste arquivo versionado.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# Mapa (módulo geo). Tudo opcional: sem valor, usa os padrões abaixo.
# ------------------------------------------------------------------------------
# Satélite (tiles raster XYZ). Padrão: Esri World Imagery, com atribuição sempre visível.
# Os termos da Esri restringem o uso do endereço público fora dos produtos Esri: para produção,
# use uma conta Esri (ArcGIS Location Platform) ou troque por MapTiler, por exemplo:
# NEXT_PUBLIC_MAP_SATELLITE_URL=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=SUA_CHAVE_PUBLICA
# (chaves de mapa ficam visíveis no navegador; restrinja-as por domínio no painel do provedor)
NEXT_PUBLIC_MAP_SATELLITE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=
# Zoom máximo das imagens (acima disso o mapa amplia a última imagem). Padrão: 17, o que a Esri
# costuma ter em áreas rurais do Pará; acima aparece "Map data not yet available".
NEXT_PUBLIC_MAP_SATELLITE_MAXZOOM=
# Rótulos (limites e nomes de lugares) por cima do satélite. Vazio = Esri; "none" = sem rótulos.
NEXT_PUBLIC_MAP_LABELS_URL=
# Centro inicial "longitude,latitude" e zoom. Padrão: Canaã dos Carajás (PA), município do piloto.
NEXT_PUBLIC_MAP_DEFAULT_CENTER=-49.8786,-6.4966
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# ------------------------------------------------------------------------------
# Variáveis EXCLUSIVAS DO SERVIDOR (ficam em apps/api/.env, NUNCA em apps/web):
# - DATABASE_URL
# - JWT_SECRET
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_JWT_SECRET
# ------------------------------------------------------------------------------
