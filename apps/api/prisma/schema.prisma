generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATION
  TECHNICIAN
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  producers    Producer[]
  properties   Property[]
  visits       Visit[]
}

// Registro de auditoria (LGPD): quem fez, o quê, quando.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Producer {
  id          String     @id @default(uuid())
  name        String
  // Nome em minúsculas e sem acentos, usado na busca.
  searchName  String
  // Somente dígitos. Nunca sai completo da API.
  cpf         String     @unique
  phone       String?
  community   String
  // Data em que o produtor autorizou o uso dos dados (LGPD). Nulo = pendente.
  consentAt   DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
  visits      Visit[]

  @@index([searchName])
}

model Property {
  id           String   @id @default(uuid())
  producerId   String
  producer     Producer @relation(fields: [producerId], references: [id])
  name         String
  // Nome + localidade em minúsculas e sem acentos, usado na busca.
  searchText   String   @default("")
  // Área digitada (sem mapa na demo).
  areaHa       Decimal  @db.Decimal(10, 2)
  locality     String
  mainActivity String?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visits       Visit[]

  @@index([producerId])
}

// Visita técnica. Depois de salva não é editada: vale como registro do atendimento.
model Visit {
  id               String       @id @default(uuid())
  producerId       String
  producer         Producer     @relation(fields: [producerId], references: [id])
  propertyId       String?
  property         Property?    @relation(fields: [propertyId], references: [id])
  technicianId     String
  technician       User         @relation(fields: [technicianId], references: [id])
  visitedOn        DateTime     @db.Date
  diagnosis        String
  actionPlan       String
  returnOn         DateTime?    @db.Date
  impact           String?
  // Assinatura do produtor (PNG desenhado na tela).
  signature        Bytes?
  // Localização registrada pelo aparelho, sem mapa.
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  createdAt        DateTime     @default(now())
  photos           VisitPhoto[]

  @@index([producerId, visitedOn])
  @@index([visitedOn])
}

model VisitPhoto {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  position  Int
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([visitId])
}
