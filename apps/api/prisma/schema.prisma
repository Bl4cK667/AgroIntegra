generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATION
  TECHNICIAN
}

model User {
  id              String           @id @default(uuid())
  authUserId      String?          @unique
  memberships     OrganizationMembership[]
  invitations     Invitation[]
  name            String
  email           String           @unique
  passwordHash    String
  role            Role
  active          Boolean          @default(true)
  // Dados da conta editáveis em Configurações.
  phone           String?
  jobTitle        String?
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  // Preferência de navegação escolhida em Configurações: "topbar" (padrão) ou "sidebar".
  navStyle        String           @default("topbar")
  // Tema visual escolhido em Configurações → Aparência (null = nunca escolheu; o app usa "pure-light").
  theme           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]
  notifications   Notification[]
  producers       Producer[]
  properties      Property[]
  visits          Visit[]
  requests        ServiceRequest[]
}

// Registro de auditoria (LGPD): quem fez, o quê, quando.
// Aviso para um usuário da equipe. Criado pelo backend quando algo relevante acontece
// (nova solicitação, mudança de situação, visita registrada...). readAt nulo = não lida.
model Notification {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model AuditLog {
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])

  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model Producer {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id          String           @id @default(uuid())
  name        String
  // Nome em minúsculas e sem acentos, usado na busca.
  searchName  String
  // Somente dígitos. Nunca sai completo da API.
  cpf         String           @unique
  phone       String?
  community   String
  // Data em que o produtor autorizou o uso dos dados (LGPD). Nulo = pendente.
  consentAt   DateTime?
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  properties  Property[]
  visits      Visit[]
  requests    ServiceRequest[]
  enrollments Enrollment[]
  deliveries  Delivery[]

  @@index([searchName])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model Property {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id           String           @id @default(uuid())
  producerId   String
  producer     Producer         @relation(fields: [producerId, organizationId], references: [id, organizationId])
  name         String
  // Nome + localidade em minúsculas e sem acentos, usado na busca.
  searchText   String           @default("")
  // Área digitada (sem mapa na demo).
  areaHa       Decimal          @db.Decimal(10, 2)
  locality     String
  mainActivity String?
  // Localização digitada (sem mapa na demo). Coordenadas em graus decimais (WGS 84).
  address      String?
  city         String?
  state        String?          @db.Char(2)
  latitude     Float?
  longitude    Float?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  visits       Visit[]
  requests     ServiceRequest[]

  @@index([producerId])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// Visita técnica. Depois de salva não é editada: vale como registro do atendimento.
model Visit {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id               String          @id @default(uuid())
  producerId       String
  producer         Producer        @relation(fields: [producerId, organizationId], references: [id, organizationId])
  propertyId       String?
  property         Property?       @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  technicianId     String
  technician       User            @relation(fields: [technicianId], references: [id])
  visitedOn        DateTime        @db.Date
  diagnosis        String
  actionPlan       String
  returnOn         DateTime?       @db.Date
  impact           String?
  // Assinatura do produtor (PNG desenhado na tela).
  signature        Bytes?
  // Localização registrada pelo aparelho, sem mapa.
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  // Solicitação que esta visita atendeu (opcional).
  requestId        String?
  request          ServiceRequest? @relation(fields: [requestId, organizationId], references: [id, organizationId])
  createdAt        DateTime        @default(now())
  photos           VisitPhoto[]

  @@index([producerId, visitedOn])
  @@index([visitedOn])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model VisitPhoto {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId, organizationId], references: [id, organizationId], onDelete: Cascade)
  position  Int
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([visitId])
  @@index([organizationId])
  @@unique([id, organizationId])
}

enum RequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  DONE
}

enum RequestPriority {
  HIGH
  MEDIUM
  LOW
}

// Pedido de atendimento do produtor, acompanhado no quadro de Solicitações.
model ServiceRequest {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id           String          @id @default(uuid())
  producerId   String
  producer     Producer        @relation(fields: [producerId, organizationId], references: [id, organizationId])
  propertyId   String?
  property     Property?       @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  subject      String
  description  String?
  priority     RequestPriority @default(MEDIUM)
  status       RequestStatus   @default(NEW)
  // Data combinada para a visita, quando a solicitação está Agendada.
  scheduledFor DateTime?       @db.Date
  // Preenchida quando a solicitação vai para Concluída; limpa se ela voltar.
  completedAt  DateTime?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  visits       Visit[]

  @@index([status])
  @@index([completedAt])
  @@index([producerId])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// Programa de fomento da secretaria. Na demo é só leitura: os dados vêm da carga de exemplo.
model Program {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id           String       @id @default(uuid())
  name         String
  description  String
  // Vagas oferecidas.
  slots        Int
  // Meta física: quantas unidades do item serão entregues (ex.: 120 kits).
  goalQuantity Int
  // Unidade no plural (ex.: "kits") e no singular (ex.: "kit"), para escrever "1 kit".
  unit         String
  unitSingular String       @default("")
  // Orçamento em centavos, para não perder precisão.
  budgetCents  Int
  startsOn     DateTime     @db.Date
  endsOn       DateTime     @db.Date
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  deliveries   Delivery[]
  @@index([organizationId])
  @@unique([id, organizationId])
}

enum EnrollmentStatus {
  ENROLLED
  APPROVED
  REJECTED
}

// Inscrição de um produtor no programa; aprovada = beneficiário.
model Enrollment {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id         String           @id @default(uuid())
  programId  String
  program    Program          @relation(fields: [programId, organizationId], references: [id, organizationId])
  producerId String
  producer   Producer         @relation(fields: [producerId, organizationId], references: [id, organizationId])
  status     EnrollmentStatus @default(ENROLLED)
  enrolledOn DateTime         @db.Date
  createdAt  DateTime         @default(now())

  @@unique([programId, producerId])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// Entrega feita a um beneficiário (quantidade do item e valor gasto).
model Delivery {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId, organizationId], references: [id, organizationId])
  producerId  String
  producer    Producer @relation(fields: [producerId, organizationId], references: [id, organizationId])
  deliveredOn DateTime @db.Date
  quantity    Int
  valueCents  Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([programId])
  @@index([producerId, deliveredOn])
  @@index([organizationId])
  @@unique([id, organizationId])
}


model Organization {
  id String @id @default(uuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships OrganizationMembership[]
  invitations Invitation[]
  notifications Notification[]
  auditLogs AuditLog[]
  producers Producer[]
  properties Property[]
  visits Visit[]
  visitPhotos VisitPhoto[]
  requests ServiceRequest[]
  programs Program[]
  enrollments Enrollment[]
  deliveries Delivery[]
}

model OrganizationMembership {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId, active])
}

model Invitation {
  id String @id @default(uuid())
  email String
  tokenHash String @unique
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  role Role
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
