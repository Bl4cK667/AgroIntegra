generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATION
  TECHNICIAN
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  producers    Producer[]
  properties   Property[]
}

// Registro de auditoria (LGPD): quem fez, o quê, quando.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Producer {
  id          String     @id @default(uuid())
  name        String
  // Nome em minúsculas e sem acentos, usado na busca.
  searchName  String
  // Somente dígitos. Nunca sai completo da API.
  cpf         String     @unique
  phone       String?
  community   String
  // Data em que o produtor autorizou o uso dos dados (LGPD). Nulo = pendente.
  consentAt   DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]

  @@index([searchName])
}

model Property {
  id           String   @id @default(uuid())
  producerId   String
  producer     Producer @relation(fields: [producerId], references: [id])
  name         String
  // Nome + localidade em minúsculas e sem acentos, usado na busca.
  searchText   String   @default("")
  // Área digitada (sem mapa na demo).
  areaHa       Decimal  @db.Decimal(10, 2)
  locality     String
  mainActivity String?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([producerId])
}
