generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATION
  TECHNICIAN
}

model User {
  id              String           @id @default(uuid())
  authUserId      String?          @unique
  memberships     OrganizationMembership[]
  invitations     Invitation[]
  name            String
  email           String           @unique
  passwordHash    String
  role            Role
  active          Boolean          @default(true)
  // Dados da conta editáveis em Configurações.
  phone           String?
  jobTitle        String?
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  // Preferência de navegação escolhida em Configurações: "topbar" (padrão) ou "sidebar".
  navStyle        String           @default("topbar")
  // Tema visual escolhido em Configurações → Aparência (null = nunca escolheu; o app usa "pure-light").
  theme           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]
  notifications   Notification[]
  producers       Producer[]
  properties      Property[]
  visits          Visit[]
  requests        ServiceRequest[]
  // Módulo geo.
  featuresCreated PropertyFeature[]        @relation("PropertyFeatureCreatedBy")
  featuresUpdated PropertyFeature[]        @relation("PropertyFeatureUpdatedBy")
  featureVersions PropertyFeatureVersion[]
  // Módulo cotacoes.
  localPrices     LocalPrice[]
}

// Registro de auditoria (LGPD): quem fez, o quê, quando.
// Aviso para um usuário da equipe. Criado pelo backend quando algo relevante acontece
// (nova solicitação, mudança de situação, visita registrada...). readAt nulo = não lida.
model Notification {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model AuditLog {
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])

  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model Producer {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id          String           @id @default(uuid())
  name        String
  // Nome em minúsculas e sem acentos, usado na busca.
  searchName  String
  // Somente dígitos. Nunca sai completo da API.
  cpf         String           @unique
  phone       String?
  community   String
  // Data em que o produtor autorizou o uso dos dados (LGPD). Nulo = pendente.
  consentAt   DateTime?
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  // Exclusão lógica (preparação para o sync offline). Nulo = ativo.
  deletedAt   DateTime?
  properties  Property[]
  visits      Visit[]
  requests    ServiceRequest[]
  enrollments Enrollment[]
  deliveries  Delivery[]

  @@index([searchName])
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@unique([id, organizationId])
}

model Property {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id           String           @id @default(uuid())
  producerId   String
  producer     Producer         @relation(fields: [producerId, organizationId], references: [id, organizationId])
  name         String
  // Nome + localidade em minúsculas e sem acentos, usado na busca.
  searchText   String           @default("")
  // Área DECLARADA, digitada (documento do CAR, matrícula). Pode divergir da calculada.
  areaHa       Decimal          @db.Decimal(10, 2)
  // Área e perímetro CALCULADOS pelo PostGIS a partir do perímetro demarcado (módulo geo).
  // Preenchidos só pelo banco (trigger em PropertyFeature); nulos enquanto não há demarcação.
  calculatedAreaHa     Decimal? @db.Decimal(14, 4)
  calculatedPerimeterM Decimal? @db.Decimal(14, 2)
  locality     String
  mainActivity String?
  // Localização digitada (sem mapa na demo). Coordenadas em graus decimais (WGS 84).
  address      String?
  city         String?
  state        String?          @db.Char(2)
  latitude     Float?
  longitude    Float?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  visits       Visit[]
  requests     ServiceRequest[]
  features     PropertyFeature[]

  @@index([producerId])
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@unique([id, organizationId])
}

// Visita técnica. Depois de salva não é editada: vale como registro do atendimento.
model Visit {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id               String          @id @default(uuid())
  producerId       String
  producer         Producer        @relation(fields: [producerId, organizationId], references: [id, organizationId])
  propertyId       String?
  property         Property?       @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  technicianId     String
  technician       User            @relation(fields: [technicianId], references: [id])
  visitedOn        DateTime        @db.Date
  diagnosis        String
  actionPlan       String
  returnOn         DateTime?       @db.Date
  impact           String?
  // Assinatura do produtor (PNG desenhado na tela).
  signature        Bytes?
  // Localização registrada pelo aparelho, sem mapa.
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  // Solicitação que esta visita atendeu (opcional).
  requestId        String?
  request          ServiceRequest? @relation(fields: [requestId, organizationId], references: [id, organizationId])
  createdAt        DateTime        @default(now())
  // A visita não é editada, mas updatedAt/deletedAt permitem ao sync propagar exclusões.
  updatedAt        DateTime        @default(now()) @updatedAt
  deletedAt        DateTime?
  photos           VisitPhoto[]

  @@index([producerId, visitedOn])
  @@index([visitedOn])
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@unique([id, organizationId])
}

model VisitPhoto {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId, organizationId], references: [id, organizationId], onDelete: Cascade)
  position  Int
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([visitId])
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@unique([id, organizationId])
}

enum RequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  DONE
}

enum RequestPriority {
  HIGH
  MEDIUM
  LOW
}

// Pedido de atendimento do produtor, acompanhado no quadro de Solicitações.
model ServiceRequest {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id           String          @id @default(uuid())
  producerId   String
  producer     Producer        @relation(fields: [producerId, organizationId], references: [id, organizationId])
  propertyId   String?
  property     Property?       @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  subject      String
  description  String?
  priority     RequestPriority @default(MEDIUM)
  status       RequestStatus   @default(NEW)
  // Data combinada para a visita, quando a solicitação está Agendada.
  scheduledFor DateTime?       @db.Date
  // Preenchida quando a solicitação vai para Concluída; limpa se ela voltar.
  completedAt  DateTime?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  visits       Visit[]

  @@index([status])
  @@index([completedAt])
  @@index([producerId])
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@unique([id, organizationId])
}

// Programa de fomento da secretaria. Na demo é só leitura: os dados vêm da carga de exemplo.
model Program {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id           String       @id @default(uuid())
  name         String
  description  String
  // Vagas oferecidas.
  slots        Int
  // Meta física: quantas unidades do item serão entregues (ex.: 120 kits).
  goalQuantity Int
  // Unidade no plural (ex.: "kits") e no singular (ex.: "kit"), para escrever "1 kit".
  unit         String
  unitSingular String       @default("")
  // Orçamento em centavos, para não perder precisão.
  budgetCents  Int
  startsOn     DateTime     @db.Date
  endsOn       DateTime     @db.Date
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  deliveries   Delivery[]
  @@index([organizationId])
  @@unique([id, organizationId])
}

enum EnrollmentStatus {
  ENROLLED
  APPROVED
  REJECTED
}

// Inscrição de um produtor no programa; aprovada = beneficiário.
model Enrollment {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id         String           @id @default(uuid())
  programId  String
  program    Program          @relation(fields: [programId, organizationId], references: [id, organizationId])
  producerId String
  producer   Producer         @relation(fields: [producerId, organizationId], references: [id, organizationId])
  status     EnrollmentStatus @default(ENROLLED)
  enrolledOn DateTime         @db.Date
  createdAt  DateTime         @default(now())

  @@unique([programId, producerId])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// Entrega feita a um beneficiário (quantidade do item e valor gasto).
model Delivery {
  organizationId String @default("00000000-0000-4000-8000-000000000001")
  organization Organization @relation(fields: [organizationId], references: [id])

  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId, organizationId], references: [id, organizationId])
  producerId  String
  producer    Producer @relation(fields: [producerId, organizationId], references: [id, organizationId])
  deliveredOn DateTime @db.Date
  quantity    Int
  valueCents  Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([programId])
  @@index([producerId, deliveredOn])
  @@index([organizationId])
  @@unique([id, organizationId])
}


model Organization {
  id String @id @default(uuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships OrganizationMembership[]
  invitations Invitation[]
  notifications Notification[]
  auditLogs AuditLog[]
  producers Producer[]
  properties Property[]
  visits Visit[]
  visitPhotos VisitPhoto[]
  requests ServiceRequest[]
  programs Program[]
  enrollments Enrollment[]
  deliveries Delivery[]
  propertyFeatures PropertyFeature[]
  propertyFeatureVersions PropertyFeatureVersion[]
  weatherForecasts WeatherForecast[]
  localPrices LocalPrice[]
}

model OrganizationMembership {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId, active])
}

model Invitation {
  id String @id @default(uuid())
  email String
  tokenHash String @unique
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  role Role
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

// ============================================================================
// Módulo geo: feições demarcadas no mapa (dono: João Pedro).
// A geometria só é gravada por SQL (o Prisma não suporta PostGIS: ver src/geo).
// areaHa, perimeterM, lengthM e version são preenchidos por trigger no banco;
// cada escrita gera uma linha em PropertyFeatureVersion (também por trigger).
// ============================================================================

enum PropertyFeatureType {
  PERIMETER     // perímetro da propriedade (MultiPolygon; um ativo por propriedade)
  PLOT          // talhão (MultiPolygon)
  APP           // área de preservação permanente (MultiPolygon)
  LEGAL_RESERVE // reserva legal (MultiPolygon)
  HEADQUARTERS  // sede (Point ou MultiPolygon)
  IMPROVEMENT   // benfeitoria (Point ou MultiPolygon)
  WATER         // água: açude, rio, nascente (MultiPolygon, MultiLineString ou Point)
  ROAD          // estrada (MultiLineString)
}

enum PropertyFeatureChange {
  CREATED
  UPDATED
  DELETED
}

model PropertyFeature {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  id          String              @id @default(uuid())
  propertyId  String
  property    Property            @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type        PropertyFeatureType
  name        String?
  geom        Unsupported("geometry(Geometry, 4326)")
  areaHa      Decimal?            @db.Decimal(14, 4)
  perimeterM  Decimal?            @db.Decimal(14, 2)
  lengthM     Decimal?            @db.Decimal(14, 2)
  version     Int                 @default(1)
  createdById String
  createdBy   User                @relation("PropertyFeatureCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User                @relation("PropertyFeatureUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  deletedAt   DateTime?
  versions    PropertyFeatureVersion[]

  @@index([propertyId, type])
  @@index([organizationId, updatedAt])
  @@index([geom], type: Gist)
  @@unique([id, organizationId])
}

// ============================================================================
// Módulo clima (dono: João Pedro): última previsão válida por fonte e local.
// Serve de cache (validade curta) e de reserva quando a fonte não responde: a tela
// mostra o último valor com aviso de desatualizado. Dado público, mas guardado por
// organização (mesmo isolamento das outras tabelas).
// ============================================================================

enum WeatherSource {
  INMET      // previsão oficial por município (código IBGE)
  OPEN_METEO // previsão por coordenada (plano comercial em produção)
}

model WeatherForecast {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  id            String        @id @default(uuid())
  source        WeatherSource
  // INMET: código IBGE do município. Open-Meteo: "lat,lng" arredondado a 0,01° (~1 km).
  locationKey   String
  // Como o local aparece na tela, ex.: "Canaã dos Carajás/PA".
  placeName     String
  // Dias já normalizados (ver src/clima/weather.types.ts).
  days          Json
  // Quando a fonte respondeu com sucesso (data/hora do dado mostrada na tela).
  fetchedAt     DateTime
  // Última tentativa com falha, para não insistir numa fonte fora do ar a cada consulta.
  lastErrorAt   DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@unique([organizationId, source, locationKey])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// ============================================================================
// Módulo cotacoes (dono: João Pedro).
// MarketPrice e MarketPriceImport são GLOBAIS (sem organizationId): preço público da CONAB,
// igual para todas as organizações. Exceção ao checklist de multi-organização aprovada em
// 18/11/2026 (ver CLAUDE.md). Preço digitado pela equipe fica em LocalPrice, por organização.
// ============================================================================

enum MarketPriceScope {
  STATE        // média da UF
  MUNICIPALITY // praça municipal
}

// Preço recebido pelo produtor, semanal (CONAB, "PREÇO RECEBIDO P/ PR").
model MarketPrice {
  id           String           @id @default(uuid())
  source       String           // "CONAB"
  productCode  String           // id_produto da CONAB
  productName  String           // ex.: "BOI"
  productClass String           // ex.: "GORDO"
  scope        MarketPriceScope
  uf           String           @db.Char(2)
  ibgeCode     String?          // só na praça municipal
  placeKey     String           // UF ("PA") ou código IBGE
  placeName    String           // ex.: "Pará" ou "Marabá/PA"
  weekStart    DateTime         @db.Date
  weekEnd      DateTime         @db.Date
  // Valor como a CONAB publica (coluna valor_produto_kg: R$/kg na maioria dos produtos).
  // A conversão para R$/@, saca etc. é feita na leitura (src/cotacoes/products.ts).
  value        Decimal          @db.Decimal(14, 4)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([source, scope, placeKey, productCode, weekStart])
  @@index([productCode, scope, weekEnd])
}

// Cada tentativa de importação (data do dado, falhas, "não mudou").
model MarketPriceImport {
  id           String    @id @default(uuid())
  source       String    // "CONAB"
  file         String    // "UF" ou "MUNICIPIO"
  status       String    // SUCCESS, NOT_MODIFIED, FAILED
  rows         Int       @default(0)
  lastModified String?   // cabeçalho Last-Modified da fonte (download condicional)
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source, file, startedAt])
}

// Preço local lançado pela equipe (feira, laticínio, frigorífico...). Por organização.
model LocalPrice {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  id          String    @id @default(uuid())
  productKey  String?   // produto da lista acompanhada (ex.: BOI_GORDO); nulo = outro produto
  productName String
  unit        String    // ex.: "R$/@", "R$/L"
  price       Decimal   @db.Decimal(14, 2)
  place       String    // praça: ex.: "Laticínio Serra Dourada, Canaã dos Carajás"
  observedOn  DateTime  @db.Date
  notes       String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([organizationId, productKey, observedOn])
  @@index([organizationId])
  @@unique([id, organizationId])
}

// Histórico da demarcação: uma linha por criação, alteração ou exclusão lógica.
model PropertyFeatureVersion {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  id          String                @id @default(uuid())
  featureId   String
  feature     PropertyFeature       @relation(fields: [featureId, organizationId], references: [id, organizationId], onDelete: Cascade)
  version     Int
  change      PropertyFeatureChange
  type        PropertyFeatureType
  name        String?
  geom        Unsupported("geometry(Geometry, 4326)")
  areaHa      Decimal?              @db.Decimal(14, 4)
  perimeterM  Decimal?              @db.Decimal(14, 2)
  lengthM     Decimal?              @db.Decimal(14, 2)
  changedById String
  changedBy   User                  @relation(fields: [changedById], references: [id])
  createdAt   DateTime              @default(now())

  @@unique([featureId, version])
  @@index([organizationId])
  @@unique([id, organizationId])
}
