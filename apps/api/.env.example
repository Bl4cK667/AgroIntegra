DATABASE_URL="postgresql://agro:agro@127.0.0.1:5433/agrointegra"
# Credenciais acima são exclusivamente do banco local da demo.
# Use 127.0.0.1, não "localhost": no Docker Desktop do Windows a porta pode não ser
# encaminhada em IPv6 (::1), e o Prisma falha com P1001 ao tentar o IPv6 primeiro.
# Produção: gerar um segredo forte, exclusivo do servidor (mínimo recomendado: 32 bytes).
JWT_SECRET="substitua-por-um-segredo-aleatorio-exclusivo-do-servidor"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Supabase permanece DESATIVADO nesta preparação. Não preencher credenciais reais neste arquivo.
# Não ativar antes de homologar identidade, sessão completa, memberships e isolamento.
SUPABASE_AUTH_ENABLED=false
SUPABASE_REGISTRATION_ENABLED=false
SUPABASE_URL=""
# Chave publicável do projeto: usada no servidor para validar login/senha de contas Supabase.
SUPABASE_PUBLISHABLE_KEY=""
# Opcionais: derivados de SUPABASE_URL quando vazios.
SUPABASE_JWT_ISSUER=""
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWKS_URL=""
# Legado HS256 apenas se necessário; preferir JWKS ES256/RS256.
# Este segredo NUNCA deve ser igual ao JWT_SECRET local.
SUPABASE_JWT_SECRET=""
# Exclusiva do servidor, necessária para criar usuários por convite com cadastro ativado.
# Antes de ativar, desligar signup público no Supabase e homologar as migrations/RLS.
SUPABASE_SERVICE_ROLE_KEY=""

# Planejadas; ainda NÃO consumidas pelo Prisma/Storage nesta fase.
# DIRECT_URL deve ser credencial separada de migração, nunca a de runtime do navegador.
DIRECT_URL=""
SUPABASE_STORAGE_VISIT_PHOTOS_BUCKET="visit-photos"
SUPABASE_STORAGE_SIGNATURES_BUCKET="visit-signatures"
SUPABASE_STORAGE_AVATARS_BUCKET="avatars"

# Documentação OpenAPI em /docs e /docs/openapi.json. Sem valor: ligada fora de produção
# (NODE_ENV diferente de "production"). Em produção, só ligar com acesso restrito.
API_DOCS_ENABLED=

# Proteção HTTP (limites por processo; produção com réplicas requer contador compartilhado).
# Só confiar em proxy quando a topologia da infraestrutura for conhecida.
TRUST_PROXY=0
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_MAX_FAILURES_PER_IP=50
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTRATION_MAX_REQUESTS=20
AUTH_REGISTRATION_WINDOW_SECONDS=900

# Módulo clima (ver README, seção "Clima").
# Município usado quando a propriedade não tem cidade/UF no cadastro (código IBGE de 7 dígitos).
CLIMA_DEFAULT_IBGE=1502152
CLIMA_DEFAULT_PLACE="Canaã dos Carajás/PA"
# Validade da previsão guardada e espera depois de uma falha da fonte (minutos).
CLIMA_CACHE_MINUTES=180
CLIMA_FAILURE_BACKOFF_MINUTES=10
CLIMA_TIMEOUT_MS=6000
CLIMA_TIMEZONE=America/Belem
INMET_BASE_URL=https://apiprevmet3.inmet.gov.br
IBGE_BASE_URL=https://servicodados.ibge.gov.br
# Open-Meteo: o plano grátis é SÓ para uso não comercial (avaliação e protótipo).
# Em produção (NODE_ENV=production) ele só liga com a chave do plano comercial.
# Sem chave usa api.open-meteo.com; com chave, customer-api.open-meteo.com.
OPEN_METEO_ENABLED=true
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=

# Módulo cotacoes (ver README, seção "Cotações").
# Preço recebido pelo produtor, semanal, da CONAB (arquivos públicos do Portal de Informações Agropecuárias).
CONAB_BASE_URL=https://portaldeinformacoes.conab.gov.br/downloads/arquivos
# UFs importadas, separadas por vírgula. Praças municipais da UF entram junto (COTACOES_MUNICIPIOS=false desliga).
COTACOES_UFS=PA
COTACOES_MUNICIPIOS=true
# Consulta diária (a CONAB atualiza às quartas; o download só acontece se o arquivo mudou).
COTACOES_SCHEDULE_ENABLED=true
COTACOES_CRON="0 30 10 * * *"
COTACOES_TIMEZONE=America/Belem
# Ao subir a API, importa se a última importação boa tiver mais de 7 dias.
COTACOES_IMPORT_ON_START=true
# Preço mais antigo que isso aparece como desatualizado (praça municipal nem aparece no painel).
COTACOES_STALE_DAYS=21
COTACOES_TIMEOUT_MS=120000
