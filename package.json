{
  "name": "agrointegra",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "setup": "npm run db:up && npm run -w apps/api db:migrate && npm run -w apps/api db:seed",
    "dev:api": "npm run -w apps/api start:dev",
    "dev:web": "npm run -w apps/web dev",
    "test": "npm run -w apps/api test"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.23.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
