{
  "name": "agrointegra",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "setup": "npm run db:up && npm run -w apps/api db:generate && npm run -w apps/api db:migrate && npm run -w apps/api db:seed",
    "dev": "concurrently --kill-others --names api,web --prefix-colors green,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api":"npm run -w apps/api start:dev",
    "dev:web": "npm run -w apps/web dev",
    "test": "npm run -w apps/api test",
    "demo:reset": "npm run -w apps/api demo:reset"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "pg": "^8.23.1"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
